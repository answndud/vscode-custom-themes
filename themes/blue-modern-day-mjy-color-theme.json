    "parameter": "#001080",
    "variable": "#001080",
    "property": "#001080",
    "enumMember": "#0070C1",
    "boolean": "#0000FF",
    "null": "#0000FF",
    "namespace": "#267F99",
    "decorator": "#3B3B3B",
