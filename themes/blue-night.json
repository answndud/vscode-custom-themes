  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#8D98B7", "fontStyle": "italic"}
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {"foreground": "#A4FBD0"}
    },
    {
      "name": "Control flow / Special keywords",
      "scope": ["keyword.control", "keyword.other", "entity.name.operator"],
      "settings": {"foreground": "#BFA7FF"}
    },
    {
      "name": "Constants and numbers",
      "scope": ["constant", "constant.numeric", "constant.language", "variable.language"],
      "settings": {"foreground": "#BFA7FF"}
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {"foreground": "#78C7C7"}
    },
    {
      "name": "RegExp",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": {"foreground": "#5FB3A1"}
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {"foreground": "#53E3FF"}
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "support.other.module",
        "support.other.module.python"
      ],
      "settings": {"foreground": "#A7D8FF"}
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {"foreground": "#72B7FF"}
    },
    {
      "name": "Tags and attributes",
      "scope": ["entity.name.tag", "entity.other.attribute-name"],
      "settings": {"foreground": "#C4B5FF"}
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "text.html.basic entity.name.tag",
        "meta.tag entity.name.tag"
      ],
      "settings": {"foreground": "#8BE9FD"}
    },
    {
      "name": "Variables and properties",
      "scope": ["variable", "variable.other", "meta.object-literal.key", "support.variable"],
      "settings": {"foreground": "#F4F7FF"}
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation"],
      "settings": {"foreground": "#B8C7FF"}
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "markup.bold"],
      "settings": {"foreground": "#8BE9FD", "fontStyle": "bold"}
    },
    {
      "name": "Markup emphasis",
      "scope": ["markup.italic", "markup.quote"],
      "settings": {"foreground": "#B79CFF", "fontStyle": "italic"}
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {"foreground": "#72E6B2", "fontStyle": "underline"}
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {"foreground": "#9D8CFF", "fontStyle": "underline"}
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "storage.type.annotation",
        "entity.name.type.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {"foreground": "#C4B5FF"}
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#8D98B7",
    "string": "#78C7C7",
    "number": "#BFA7FF",
    "operator": "#B8C7FF",
    "function": "#53E3FF",
    "method": "#53E3FF",
    "class": "#72B7FF",
    "interface": "#72B7FF",
    "type": "#72B7FF",
    "typeParameter": "#C4B5FF",
    "parameter": "#F4F7FF",
    "variable": "#F4F7FF",
    "property": "#D6E3FF",
    "enumMember": "#72E6B2",
    "namespace": "#A7D8FF",
    "decorator": "#C4B5FF",
    "label": "#72E6B2",
    "regexp": "#5FB3A1"
  }
}
