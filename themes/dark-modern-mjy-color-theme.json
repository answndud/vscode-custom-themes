  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#8D98B7", "fontStyle": "italic"}
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
      "settings": {"foreground": "#B8D7FF"}
    },
    {
      "name": "Python control flow",
      "scope": ["keyword.control.flow.python"],
      "settings": {"foreground": "#78D8C8"}
    },
    {
      "name": "Python import keywords",
      "scope": ["keyword.control.import.python"],
      "settings": {"foreground": "#78D8C8"}
    },
    {
      "name": "Python function definition",
      "scope": ["storage.type.function.python"],
      "settings": {"foreground": "#E7B8FF"}
    },
    {
      "name": "Python declarations and modifiers",
      "scope": [
        "storage.type.class.python",
        "storage.type.function.async.python",
        "storage.type.function.lambda.python"
      ],
      "settings": {"foreground": "#E7B8FF"}
    },
    {
      "name": "Python declaration modifiers",
      "scope": ["storage.modifier.declaration.python"],
      "settings": {"foreground": "#C4B5FF"}
    },
    {
      "name": "Python special variables",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python"
      ],
      "settings": {"foreground": "#F4F7FF"}
    },
    {
      "name": "JavaScript and TypeScript control flow",
      "scope": [
        "keyword.control.conditional.js",
        "keyword.control.flow.js",
        "keyword.control.loop.js",
        "keyword.control.switch.js",
        "keyword.control.trycatch.js",
