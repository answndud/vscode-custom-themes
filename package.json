{
  "name": "vscode-custom-themes",
  "displayName": "VS Code Custom Themes",
  "description": "A collection of six VS Code color themes by MJY for dark and light coding environments.",
  "version": "0.4.3",
  "publisher": "mjy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Blue Night (MJY)",
        "uiTheme": "vs-dark",
        "path": "./themes/blue-night.json"
      },
      {
        "label": "Black Night (MJY)",
        "uiTheme": "vs-dark",
        "path": "./themes/black-night.json"
      },
      {
        "label": "Black Night Modern (MJY)",
        "uiTheme": "vs-dark",
        "path": "./themes/black-night-modern.json"
      },
      {
        "label": "Blue Light (MJY)",
        "uiTheme": "vs",
        "path": "./themes/blue-light.json"
      },
      {
        "label": "Blue Light Fundamentalism (MJY)",
        "uiTheme": "vs",
        "path": "./themes/blue-light-fundamentalism.json"
      },
      {
        "label": "Blue Light Modern (MJY)",
        "uiTheme": "vs",
        "path": "./themes/blue-light-modern.json"
      }
    ]
  }
