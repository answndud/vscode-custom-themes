{
  "name": "vscode-custom-themes",
  "displayName": "VS Code Custom Themes",
  "description": "A collection of five VS Code color themes by MJY for dark and light coding environments.",
  "version": "0.4.3",
  "publisher": "mjy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Blue Night (MJY)",
        "uiTheme": "vs-dark",
        "path": "./themes/night-mjy-color-theme.json"
      },
      {
        "label": "Dark Night (MJY)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-modern-mjy-color-theme.json"
      },
      {
        "label": "Dark Night Modern (MJY)",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-night-modern-mjy-color-theme.json"
      },
      {
        "label": "Blue Day (MJY)",
        "uiTheme": "vs",
        "path": "./themes/day-mjy-color-theme.json"
      },
      {
        "label": "Blue Day Modern (MJY)",
        "uiTheme": "vs",
        "path": "./themes/blue-modern-day-mjy-color-theme.json"
      },
      {
        "label": "Red Day (MJY)",
        "uiTheme": "vs",
        "path": "./themes/red-day-mjy-color-theme.json"
      }
    ]
  }
}
